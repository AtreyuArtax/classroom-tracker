{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClassroomTrackerCurriculumPreset",
  "description": "JSON Schema for Classroom Tracker Ontario Curriculum Presets",
  "type": "object",
  "required": [
    "presetId",
    "title",
    "panel",
    "region",
    "grade",
    "subjectCode",
    "strands"
  ],
  "properties": {
    "presetId": {
      "type": "string",
      "description": "Unique identifier, e.g. 'ontario-g7-science' or 'ontario-snc1w'",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "description": "Full display title, e.g. 'Grade 7 Science and Technology (2022)'"
    },
    "panel": {
      "type": "string",
      "enum": ["elementary", "secondary"],
      "description": "School panel level"
    },
    "region": {
      "type": "string",
      "default": "Ontario",
      "description": "Educational jurisdiction"
    },
    "grade": {
      "type": "string",
      "description": "Grade level, e.g. '7', '8', '9', '10', '11', '12'"
    },
    "subjectCode": {
      "type": "string",
      "description": "Standard subject or ministry course code, e.g. 'SCI', 'MAT', 'SNC1W', 'SCH3U'"
    },
    "department": {
      "type": "string",
      "description": "Optional department for secondary courses, e.g. 'Science', 'Mathematics', 'Arts'"
    },
    "isSuccessCriteria": {
      "type": "boolean",
      "description": "Optional flag if the preset provides teacher-friendly success criteria wording"
    },
    "strands": {
      "type": "array",
      "description": "List of curriculum strands",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "overalls"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Strand name, e.g. 'A. STEM Investigation and Communication Skills' or 'Strand A: Life Systems'"
          },
          "overalls": {
            "type": "array",
            "description": "Overall expectations under this strand",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["code", "description"],
              "properties": {
                "code": {
                  "type": "string",
                  "description": "Overall expectation code, e.g. 'A1', 'B1'",
                  "pattern": "^[A-Z]\\d+$"
                },
                "title": {
                  "type": "string",
                  "description": "Optional title of the overall expectation"
                },
                "description": {
                  "type": "string",
                  "description": "Clean plaintext description of the overall expectation (no HTML entities)"
                },
                "specifics": {
                  "type": "array",
                  "description": "Specific expectations under this overall expectation",
                  "items": {
                    "type": "object",
                    "required": ["code", "description"],
                    "properties": {
                      "code": {
                        "type": "string",
                        "description": "Specific expectation code, e.g. 'A1.1', 'B2.3'",
                        "pattern": "^[A-Z]\\d+\\.\\d+$"
                      },
                      "description": {
                        "type": "string",
                        "description": "Clean plaintext description of the specific expectation (no HTML entities)"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
